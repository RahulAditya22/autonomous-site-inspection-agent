# REQUIRED: paste your Google Gemini API key between the quotes on this line.
GEMINI_API_KEY=""

# Optional: leave blank to disable webhook alerts.
ALERT_WEBHOOK_URL=""

# Gemini model. gemini-2.5-flash is recommended for this project.
GEMINI_MODEL="gemini-2.5-flash"

# Detection confidence threshold applied to model output.
CONFIDENCE_THRESHOLD="0.65"
